SYNAPSE_URL=https://your-synapse-host.example
# Same random secret as the PHP host. Inject through Secret Manager in Cloud Run.
COLLECTOR_TOKEN=
# Empty means daily scheduled run; the admin trigger overrides this for a reserved run.
COLLECTOR_RUN_ID=
COLLECTOR_MAX_SECONDS=900
COLLECTOR_BROWSER_ENABLED=false
COLLECTOR_SERPAPI_KEY=
CHROMIUM_PATH=
FUZU_BROWSER_HEADLESS=true
